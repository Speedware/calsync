@DOMAIN@ {
	root * @DIR@
	encode gzip

	@cal path /cal/*.ics
	handle @cal {
		header Content-Type "text/calendar; charset=utf-8"
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=1800"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
